{
  "name": "deneme-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "deneme - Windows masaüstü istemci + sunucu yönetimi",
  "author": "",
  "license": "ISC",
  "type": "module",
  "main": "dist-electron/main/index.mjs",
  "scripts": {
    "postinstall": "node scripts/copy-deneme-server.mjs && node scripts/patch-rnw-alert.mjs",
    "predev": "node scripts/copy-deneme-server.mjs && node scripts/patch-rnw-alert.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "prebuild": "node scripts/copy-deneme-server.mjs && node scripts/patch-rnw-alert.mjs",
    "build": "npm run typecheck && vite build",
    "package": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "deneme-server": "file:../server-app",
    "dotenv": "^17.4.2",
    "electron-store": "^10.1.0",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "^5.7.1",
    "react-native-web": "^0.21.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.5.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-rnw": "^0.0.12"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild": true,
    "electron-winstaller@5.4.0": true
  }
}
